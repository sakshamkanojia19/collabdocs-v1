NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
MONGO_URI=mongodb://localhost:27017/collabdocs
MONGO_MAX_POOL_SIZE=20
REDIS_URL=redis://localhost:6379/0
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-random-secret
AUTH_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_MAX_DOCUMENT_CHARS=500000
AI_REQUESTS_PER_MINUTE=10
KAFKA_BROKERS=
LOG_LEVEL=info

# Platform super admins (comma-separated emails). Members get full AI access and the admin console.
SUPER_ADMIN_EMAILS=
