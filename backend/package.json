{
  "name": "collabdocs-backend",
  "version": "0.1.0",
  "private": true,
  "description": "CollabDocs modular-monolith backend",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "bootstrap": "npm install --workspaces",
    "start": "node src/server.js",
    "dev": "nodemon --watch src --ext js,json src/server.js",
    "check": "node scripts/check_syntax.js",
    "migrate:tenancy": "node scripts/migrate-tenancy.js",
    "test": "node --test tests/app.test.js tests/document-policy.test.js tests/ai-rag.test.js tests/knowledge-work.test.js tests/entitlements.test.js tests/tenancy.test.js",
    "test:db": "node --test tests/database-smoke.test.js tests/realtime-smoke.test.js"
  },
  "dependencies": {
    "@collabdocs/shared": "file:packages/shared",
    "@upstash/redis": "^1.34.3",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "http-errors": "^2.0.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0",
    "openai": "^6.48.0",
    "socket.io": "^4.8.1",
    "winston": "^3.13.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "socket.io-client": "^4.8.1"
  },
  "engines": {
    "node": ">=18.18.0",
    "npm": ">=9.0.0"
  },
  "license": "MIT"
}
